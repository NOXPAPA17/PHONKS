--// MASTER SHOW / HIDE
local masterDown = false
local masterMoved = false
local masterStart
local masterPosition

master.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then

masterDown = true
masterMoved = false
masterStart = input.Position
masterPosition = master.Position
end
end)

UserInputService.InputChanged:Connect(function(input)
if not masterDown then
return
end

if input.UserInputType == Enum.UserInputType.MouseMovement
or input.UserInputType == Enum.UserInputType.Touch then

if (input.Position - masterStart).Magnitude > 10 then
masterMoved = true
end
end
end)

master.Activated:Connect(function()
if not masterMoved then
border.Visible = not border.Visible
end
end)

UserInputService.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then

masterDown = false
end
end)

